<Window x:Class="TtsUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TtsUtil.App"
        Title="TTS Util Win" Height="660" Width="940" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing" Deactivated="OnWindowDeactivated"
        PreviewMouseLeftButtonDown="OnPreviewButtonPress">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveScriptCommand" />
        <CommandBinding Command="ApplicationCommands.Replace" Executed="OnToggleFindCommand" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnSaveAudioCommand" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="ApplicationCommands.Save" />
        <KeyBinding Modifiers="Control" Key="H" Command="ApplicationCommands.Replace" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="ApplicationCommands.SaveAs" />
    </Window.InputBindings>
    <DockPanel Margin="12">

        <Border DockPanel.Dock="Top" Padding="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Voice" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="ShowFavouriteVoicesButton" DockPanel.Dock="Right" Content="Favorites"
                            Width="82" Margin="6,0,0,0" ToolTip="Show only starred voices"
                            Click="OnShowFavouriteVoices" />
                    <ToggleButton x:Name="FavouriteVoiceButton" DockPanel.Dock="Right" Content="Star"
                                  Width="56" Margin="6,0,0,0" ToolTip="Keep this voice at the top of the list"
                                  Click="OnToggleFavouriteVoice" />
                    <ComboBox x:Name="VoiceBox" MinWidth="220" SelectionChanged="OnVoiceChanged" />
                </DockPanel>

                <Label Grid.Row="0" Grid.Column="2" Content="Speed" />
                <Slider x:Name="SpeedSlider" Grid.Row="0" Grid.Column="3" Minimum="0.5" Maximum="2.0" Value="0.9"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="4,0,8,0" ValueChanged="OnSpeedChanged" />
                <TextBlock x:Name="SpeedText" Grid.Row="0" Grid.Column="4" Text="1.00x" VerticalAlignment="Center"
                           Margin="0,0,12,0" MinWidth="44" />

                <Button x:Name="RescanButton" Grid.Row="0" Grid.Column="5" Content="Rescan"
                        Click="OnRescanVoices" Margin="0" />

                <StackPanel x:Name="SpeakerPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <Label x:Name="SpeakerLabel" Content="Speaker" VerticalAlignment="Center" />
                    <TextBox x:Name="SpeakerSearchBox" Tag="Filter speakers" Width="150" Margin="4,0,6,0" Padding="3,2"
                             VerticalAlignment="Center" ToolTip="Filter speakers by name or number"
                             TextChanged="OnSpeakerSearchChanged" />
                    <ComboBox x:Name="SpeakerBox" MinWidth="200" MaxDropDownHeight="360"
                              VerticalAlignment="Center" SelectionChanged="OnSpeakerChanged" />
                    <ToggleButton x:Name="FavouriteSpeakerButton" Content="Star" Width="56" Margin="6,0,0,0"
                                  VerticalAlignment="Center" ToolTip="Keep this speaker at the top of the list"
                                  Click="OnToggleFavouriteSpeaker" />
                    <Button x:Name="ShowFavouritesButton" Content="Favorites" Width="82" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="Show only starred speakers"
                            Click="OnShowFavouriteSpeakers" />
                    <TextBlock x:Name="SpeakerCountText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="#555" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready." VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ToggleButton x:Name="StatusHistoryButton" Grid.Column="1" Content="History" Width="72"
                              Margin="8,0,8,0" Padding="4,1" VerticalAlignment="Center"
                              ToolTip="Recent messages"
                              Checked="OnShowStatusHistory" Unchecked="OnHideStatusHistory" />

                <Popup x:Name="StatusHistoryPopup" PlacementTarget="{Binding ElementName=StatusHistoryButton}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       Closed="OnStatusHistoryClosed">
                    <Border Background="White" BorderBrush="#BBB" BorderThickness="1" Padding="6"
                            MaxWidth="620" MaxHeight="360" MinWidth="420">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent messages, newest first"
                                       Foreground="#555" Margin="2,0,2,6" />

                            <!-- Page 1 is the newest, so the numbers count backwards in time. -->
                            <Grid DockPanel.Dock="Bottom" Margin="2,6,2,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="HistoryOlderButton" Content="&#x3C;" Width="28" Padding="0,1"
                                            Click="OnHistoryOlder" ToolTip="One page further back" />
                                    <TextBlock Text="page" VerticalAlignment="Center" Foreground="#555"
                                               Margin="8,0,4,0" />
                                    <TextBox x:Name="HistoryPageBox" Tag="Page" Width="42" Padding="2,1"
                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                             KeyDown="OnHistoryPageTyped" LostFocus="OnHistoryPageBoxLost"
                                             ToolTip="Type a page number and press Enter" />
                                    <TextBlock x:Name="HistoryPageCountText" VerticalAlignment="Center"
                                               Foreground="#555" Margin="4,0,8,0" />
                                    <Button x:Name="HistoryNewerButton" Content="&#x3E;" Width="28" Padding="0,1"
                                            Click="OnHistoryNewer" ToolTip="One page towards the recent" />
                                    <Button x:Name="HistoryNewestButton" Content="&#x3E;&#x3E;" Width="34"
                                            Padding="0,1" Margin="4,0,0,0" Click="OnHistoryNewest"
                                            ToolTip="Back to the newest" />
                                </StackPanel>
                                <Button x:Name="CopyHistoryButton" Content="Copy all" Padding="6,1"
                                        HorizontalAlignment="Right" Click="OnCopyHistory"
                                        ToolTip="Copy every kept message to the clipboard" />
                            </Grid>

                            <Grid>
                                <TextBlock x:Name="HistoryEmptyText" Text="Nothing yet." Foreground="#777"
                                           Margin="2" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="HistoryRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- One border per entry, so a wrapped line still reads as one. -->
                                                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="2"
                                                        Background="#FAFAFA" Padding="6,4" Margin="0,0,0,4">
                                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                                             BorderThickness="0" Background="Transparent"
                                                             Padding="0" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Popup>

                <ProgressBar x:Name="Progress" Grid.Column="2" Height="14" Minimum="0" Maximum="100" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" SelectionChanged="OnMainTabChanged">

            <TabItem x:Name="TextTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Text" />
                        <TextBlock x:Name="TextTabMark" Text="!" FontWeight="Bold" Foreground="#C0392B"
                                   Margin="4,0,0,0" Visibility="Collapsed" ToolTip="New tabs opened" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="10">
                    <!-- The title sits with the text it names, and saves with the button beside it. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="SaveScriptFromTextButton" DockPanel.Dock="Left"
                                Style="{StaticResource IconButton}" Content="&#xE792;"
                                AutomationProperties.Name="Save script" Click="OnSaveScript"
                                ToolTip="Save as a script (Ctrl+S)" Margin="0,0,8,0" />
                        <TextBlock Text="Title" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555" />
                        <TextBox x:Name="TextTitleBox" Tag="The name this text is saved under" Padding="6,4" FontSize="14"
                                 VerticalContentAlignment="Center" TextChanged="OnTitleBoxChanged"
                                 ToolTip="The name this text is saved under in the Scripts tab" />
                    </DockPanel>

                    <WrapPanel x:Name="TextToolBar" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                                AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" Click="OnUndo" />
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;"
                                AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" Click="OnRedo" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <Button x:Name="CutButton" Style="{StaticResource IconButton}" Content="&#xE8C6;"
                                AutomationProperties.Name="Cut" ToolTip="Cut (Ctrl+X)" Click="OnCut" />
                        <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                AutomationProperties.Name="Copy" ToolTip="Copy (Ctrl+C)" Click="OnCopy" />
                        <Button x:Name="PasteIntoTextButton" Style="{StaticResource IconButton}" Content="&#xE77F;"
                                AutomationProperties.Name="Paste" ToolTip="Paste (Ctrl+V)"
                                Click="OnPasteClipboard" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <Button x:Name="BulletsButton" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                                AutomationProperties.Name="Bulleted list" ToolTip="Bulleted list"
                                Click="OnToggleBullets" />
                        <Button x:Name="NumbersButton" Style="{StaticResource TextToolButton}" Content="1."
                                AutomationProperties.Name="Numbered list" ToolTip="Numbered list"
                                Click="OnToggleNumbers" />
                        <Button x:Name="OutdentButton" Style="{StaticResource TextToolButton}" Content="&#x21E4;"
                                AutomationProperties.Name="Outdent" ToolTip="Outdent" Click="OnOutdent" />
                        <Button x:Name="IndentButton" Style="{StaticResource TextToolButton}" Content="&#x21E5;"
                                AutomationProperties.Name="Indent" ToolTip="Indent" Click="OnIndent" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <Button x:Name="UpperCaseButton" Style="{StaticResource TextToolButton}" Content="AA"
                                AutomationProperties.Name="Upper case" ToolTip="UPPER CASE" Click="OnUpperCase" />
                        <Button x:Name="LowerCaseButton" Style="{StaticResource TextToolButton}" Content="aa"
                                AutomationProperties.Name="Lower case" ToolTip="lower case" Click="OnLowerCase" />
                        <Button x:Name="SentenceCaseButton" Style="{StaticResource TextToolButton}" Content="Aa"
                                AutomationProperties.Name="Sentence case" ToolTip="Sentence case"
                                Click="OnSentenceCase" />
                        <Button x:Name="TitleCaseButton" Style="{StaticResource TextToolButton}" Content="Ab"
                                AutomationProperties.Name="Title case" ToolTip="Title Case" Click="OnTitleCase" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                            <MenuItem x:Name="CleanUpMenu" Header="Clean up" Padding="8,5">
                                <MenuItem x:Name="JoinWrappedItem" Header="Join wrapped lines"
                                          Click="OnJoinWrappedLines" />
                                <MenuItem x:Name="CollapseBlanksItem" Header="Collapse blank lines"
                                          Click="OnCollapseBlankLines" />
                                <MenuItem x:Name="TidySpacingItem" Header="Tidy spacing" Click="OnTidySpacing" />
                            </MenuItem>
                        </Menu>
                        <Button x:Name="FindButton" Style="{StaticResource IconButton}" Content="&#xE721;"
                                AutomationProperties.Name="Find and replace" ToolTip="Find and replace (Ctrl+H)"
                                Click="OnToggleFind" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <TextBlock Text="Size" VerticalAlignment="Center" Foreground="#555" Margin="0,0,6,0" />
                        <ComboBox x:Name="EditorFontSizeBox" Width="60" VerticalAlignment="Center"
                                  ToolTip="How big the text looks here. Nothing that is saved changes."
                                  SelectionChanged="OnEditorFontSizeChanged" />
                        <CheckBox x:Name="WrapTextBox" Content="Wrap" VerticalAlignment="Center" IsChecked="True"
                                  Margin="10,0,0,0" Checked="OnWrapChanged" Unchecked="OnWrapChanged" />
                    </WrapPanel>

                    <DockPanel x:Name="FindPanel" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" />
                        <TextBox x:Name="FindBox" Tag="Find" DockPanel.Dock="Left" Width="160" Padding="4,3"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="Replace with" VerticalAlignment="Center" Margin="10,0,6,0"
                                   Foreground="#555" DockPanel.Dock="Left" />
                        <Button x:Name="ReplaceAllButton" DockPanel.Dock="Right" Content="Replace all"
                                Click="OnReplaceAll" Margin="8,0,0,0" />
                        <CheckBox x:Name="MatchCaseBox" DockPanel.Dock="Right" Content="Match case"
                                  VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox x:Name="ReplaceBox" Tag="Replace with" Padding="4,3" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ReadButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                AutomationProperties.Name="Read" Click="OnReadText" ToolTip="Read" />
                        <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;"
                                AutomationProperties.Name="Pause" Click="OnTogglePause" ToolTip="Pause" />
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;"
                                AutomationProperties.Name="Stop" Click="OnStop" ToolTip="Stop" />
                        <Button x:Name="ResumeButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                AutomationProperties.Name="Carry on" Visibility="Collapsed"
                                Click="OnResumeFromStop" ToolTip="Carry on from where you stopped" />
                        <Button x:Name="TextRepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;"
                                Click="OnCycleRepeat" Margin="12,0,0,0"
                                ToolTip="Repeat off, then the whole queue, then one entry" />
                        <Button x:Name="SaveWaveButton" Style="{StaticResource IconButton}" Content="&#xE74E;"
                                AutomationProperties.Name="Save audio" Click="OnSaveTextToWave"
                                ToolTip="Save audio (Ctrl+Shift+S)" Margin="12,0,4,0" />
                        <Button x:Name="PasteButton" Content="Paste" Click="OnPasteClipboard" />
                        <Button x:Name="ClearButton" Content="Clear" Click="OnClearText" />
                        <Button x:Name="NewDocumentButton" Content="New tab" Click="OnNewDocument"
                                Margin="6,0,0,0" ToolTip="Another text tab, written to audio alongside this one" />
                        <CheckBox x:Name="ReadAsYouTypeBox" Content="Read as I type" VerticalAlignment="Center"
                                  Margin="10,0,0,0" Checked="OnReadAsYouTypeChanged" Unchecked="OnReadAsYouTypeChanged" />
                        <CheckBox x:Name="PauseWhenUnfocusedBox" Content="Pause when I click away"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  ToolTip="Hold the reading whenever another window takes over"
                                  Checked="OnPauseWhenUnfocusedChanged" Unchecked="OnPauseWhenUnfocusedChanged" />
                        <CheckBox x:Name="ShowLinesBox" Content="Lines" VerticalAlignment="Center" IsChecked="True"
                                  Margin="10,0,0,0" Checked="OnShowLinesChanged" Unchecked="OnShowLinesChanged" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="LineListColumn" Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- A tab header is laid out by the strip, not by itself, so the
                             stretch that puts the close button at the right edge belongs here. -->
                        <TabControl x:Name="DocumentTabs" Grid.Column="0" Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    local:TabStripSizing.Enabled="True"
                                    Style="{StaticResource ScrollingTabs}"
                                    SelectionChanged="OnDocumentTabChanged" />

                        <GridSplitter x:Name="LineSplitter" Grid.Column="1" Width="6"
                                      HorizontalAlignment="Stretch" Background="Transparent" />

                        <DockPanel x:Name="LinePanel" Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <!-- Read from here belongs beside the lines it reads from, not in the row below. -->
                                <Button x:Name="ReadFromHereButton" DockPanel.Dock="Left"
                                        Style="{StaticResource IconButton}" Content="&#xE72A;"
                                        AutomationProperties.Name="Read from here" Click="OnReadFromHere"
                                        ToolTip="Read from here" Margin="0,0,6,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#555" VerticalAlignment="Center"
                                           Text="Double click a line to read from there, or select one and press this."
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <ListBox x:Name="LineList" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     HorizontalContentAlignment="Stretch"
                                     MouseDoubleClick="OnLineListDoubleClick" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Scripts">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#555" TextWrapping="Wrap"
                                   Text="Saved scripts are plain text files, so you can edit them outside the program too." />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="TickEveryScriptButton" Content="Tick all" Width="70"
                                    Margin="0,0,6,0" Click="OnTickEveryScript" />
                            <Button x:Name="ClearScriptTicksButton" Content="Clear" Width="70"
                                    Margin="0,0,6,0" Click="OnClearScriptTicks" />
                            <Button x:Name="ConvertScriptsButton" Content="Convert ticked to audio" Width="160"
                                    Click="OnConvertScripts" />
                        </WrapPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="26,0,2,2">
                            <TextBlock DockPanel.Dock="Right" Text="Voice" Width="96" Margin="8,0,0,0"
                                       FontWeight="SemiBold" Foreground="#555" />
                            <TextBlock Text="Script" FontWeight="SemiBold" Foreground="#555" />
                        </DockPanel>
                        <ListBox x:Name="ScriptList" SelectionChanged="OnScriptSelected"
                                 MouseDoubleClick="OnScriptDoubleClick"
                                 ToolTip="Double click a script to open it in a new tab"
                                 local:RowTicking.Enabled="True"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Chosen, Mode=TwoWay}"
                                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Convert this script" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Voice}" Width="96"
                                                   Margin="8,0,0,0" Foreground="#555"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Voice}" />
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <!-- One title, shown in both tabs, so saving from either uses the same name. -->
                            <TextBox x:Name="ScriptTitleBox" Tag="The name this script is saved under" Grid.Column="1" Padding="4,4"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Text, ElementName=TextTitleBox, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <Button x:Name="SaveScriptButton" Content="Save from Text tab" Width="150"
                                    Margin="0,0,8,6" Click="OnSaveScript" />
                            <Button x:Name="OpenScriptButton" Content="Open in Text tab" Width="150"
                                    Margin="0,0,8,6" Click="OnOpenScript" />
                            <Button x:Name="RenameScriptButton" Content="Rename" Width="90" Margin="0,0,8,6"
                                    Click="OnRenameScript" />
                            <Button x:Name="DeleteScriptButton" Content="Delete" Width="90" Margin="0,0,8,6"
                                    Click="OnDeleteScript" />
                            <Button x:Name="ScriptFolderButton" Content="Open folder" Width="110" Margin="0,0,8,6"
                                    Click="OnOpenScriptFolder" />
                        </WrapPanel>

                        <TextBlock x:Name="ScriptFolderText" DockPanel.Dock="Bottom" Foreground="#555"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBox x:Name="ScriptPreview" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="6" Background="#FAFAFA" />
                    </DockPanel>

                    <DockPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,4" />

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="AddToQueueButton" Style="{StaticResource IconButton}" Content="&#xE710;"
                                    AutomationProperties.Name="Add to queue" Click="OnAddToQueue"
                                    ToolTip="Add the selected script, or the Text tab when none is selected" />
                            <Button x:Name="RemoveFromQueueButton" Style="{StaticResource IconButton}"
                                    Content="&#xE74D;" AutomationProperties.Name="Remove from queue"
                                    Click="OnRemoveFromQueue" ToolTip="Remove the selected entry" />
                            <Button x:Name="MoveQueueUpButton" Style="{StaticResource IconButton}" Content="&#xE74A;"
                                    AutomationProperties.Name="Move up" Click="OnMoveQueueItemUp"
                                    ToolTip="Move the selected entry up" />
                            <Button x:Name="MoveQueueDownButton" Style="{StaticResource IconButton}"
                                    Content="&#xE74B;" AutomationProperties.Name="Move down"
                                    Click="OnMoveQueueItemDown" ToolTip="Move the selected entry down" />
                            <Button x:Name="ClearQueueButton" Style="{StaticResource IconButton}" Content="&#xE894;"
                                    AutomationProperties.Name="Clear the queue" Click="OnClearQueue"
                                    ToolTip="Empty the queue" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="PlayQueueButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                    AutomationProperties.Name="Play the queue" Click="OnPlayQueue"
                                    ToolTip="Play from the selected entry, or from the top" />
                            <Button x:Name="RepeatModeButton" Style="{StaticResource IconButton}" Content="&#xE8EE;"
                                    Click="OnCycleRepeat"
                                    ToolTip="Repeat off, then the whole queue, then one entry" />
                            <TextBlock x:Name="RepeatModeText" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="#555" />
                            <TextBlock x:Name="QueueCountText" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="#555" />
                        </StackPanel>

                        <ListBox x:Name="QueueList" HorizontalContentAlignment="Stretch"
                                 MouseDoubleClick="OnQueueDoubleClick" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="File">
                <StackPanel Margin="10">
                    <TextBlock Text="Text file or PDF" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" Tag="The file to read from" Grid.Column="0" Padding="4,4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="OnBrowseInputFile" />
                        <Button x:Name="FileHelpButton" Grid.Column="2" Style="{StaticResource HelpButton}"
                                AutomationProperties.Name="About taking files in" Click="OnFileHelp"
                                ToolTip="Which files can be read in, and what happens to them" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ReadFileButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                AutomationProperties.Name="Read file" Click="OnReadFile" ToolTip="Read file" />
                        <Button x:Name="PauseFileButton" Style="{StaticResource IconButton}" Content="&#xE769;"
                                AutomationProperties.Name="Pause" Click="OnTogglePause" ToolTip="Pause" />
                        <Button x:Name="StopFileButton" Style="{StaticResource IconButton}" Content="&#xE71A;"
                                AutomationProperties.Name="Stop" Click="OnStop" ToolTip="Stop" />
                        <Button x:Name="ConvertFileButton" Style="{StaticResource IconButton}" Content="&#xE74E;"
                                AutomationProperties.Name="Convert to audio" Click="OnSaveFileToWave"
                                ToolTip="Convert to audio" Margin="12,0,8,0" />
                        <Button x:Name="ImportTextButton" Content="Import to Text tab" Width="140"
                                Click="OnImportFileToTextTab" />
                    </StackPanel>
                    <TextBlock Text="Several files at once" Margin="0,16,0,6" Foreground="#555" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenManyInTabsButton" Content="Open files in tabs" Width="160"
                                Click="OnOpenManyInTabs"
                                ToolTip="Choose several PDFs or text files. Each one opens as its own tab, named after the file" />
                        <Button x:Name="SaveManyAsScriptsButton" Content="Save files as scripts" Width="160"
                                Click="OnSaveManyAsScripts"
                                ToolTip="Choose several PDFs or text files. Each one is saved as a script, named after the file" />
                    </StackPanel>
                    <CheckBox x:Name="AlsoSaveScriptsBox" Content="Opening in tabs also saves them as scripts"
                              Margin="0,8,0,0"
                              ToolTip="Off by default, so files opened in tabs stay out of the script library until you save them" />

                    <TextBlock x:Name="FileInfoText" Margin="0,14,0,0" Foreground="#555" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Voices">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                               Text="Voices are downloaded from the sherpa-onnx release page and unpacked into the voices directory. The license shown here is a summary; the authoritative text ships inside each model folder." />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallVoiceButton" Content="Install" Width="110"
                                    Click="OnInstallVoice" />
                            <Button x:Name="RemoveVoiceButton" Content="Remove" Width="110"
                                    Click="OnRemoveVoice" />
                            <Button x:Name="CancelVoiceButton" Content="Cancel" Width="110" IsEnabled="False"
                                    Click="OnCancelVoiceInstall" />
                            <Button x:Name="RescanVoicesButton" Content="Rescan" Width="110"
                                    Click="OnRescanVoices" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="VoiceLinkBox" Width="340" Padding="4,4"
                                     VerticalContentAlignment="Center"
                                     Tag="Link to a voice archive, ending .tar.bz2" />
                            <Button x:Name="ImportVoiceButton" Content="Import voice library" Width="150"
                                    Margin="8,0,0,0" Click="OnImportVoiceLibrary"
                                    ToolTip="Download the archive at that link and unpack it beside the other voices" />
                            <Button x:Name="VoiceSourcesButton" Style="{StaticResource HelpButton}"
                                    Click="OnVoiceSources" ToolTip="Where to find more voices" />
                        </StackPanel>

                        <ProgressBar x:Name="VoiceProgress" Height="16" Margin="0,8,0,0" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="VoiceInstallStatus" Margin="0,6,0,0" Foreground="#555"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VoiceTargetText" Margin="0,4,0,0" Foreground="#777"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ListView x:Name="VoiceCatalogueList" SelectionMode="Single"
                              local:RowTicking.Enabled="True"
                              PreviewMouseRightButtonDown="OnVoiceRowRightClick"
                              ToolTip="Right click a voice for install, uninstall and where it lives">
                        <ListView.ContextMenu>
                            <ContextMenu x:Name="VoiceRowMenu" Opened="OnVoiceMenuOpened">
                                <MenuItem x:Name="VoiceMenuInstall" Header="Install" Click="OnInstallVoice" />
                                <MenuItem x:Name="VoiceMenuRemove" Header="Uninstall" Click="OnRemoveVoice" />
                                <Separator />
                                <MenuItem x:Name="VoiceMenuWeb" Header="Go to web location"
                                          Click="OnOpenVoiceWebLocation" />
                                <MenuItem x:Name="VoiceMenuFolder" Header="Go to file location"
                                          Click="OnOpenVoiceFolder" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Install" Width="52">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Ticked, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      AutomationProperties.Name="Install this voice" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Voice" Width="250" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="Language" Width="190" DisplayMemberBinding="{Binding Language}" />
                                <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="License" Width="230" DisplayMemberBinding="{Binding Licence}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Aliases">
                <!-- The grid keeps a usable height and the page scrolls once the window is shorter
                     than the rules, the rulesets and the try it box together. -->
                <ScrollViewer x:Name="AliasScroll" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="12" MinHeight="620"
                           Height="{Binding ViewportHeight, ElementName=AliasScroll}">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                               Text="An alias tells the voice to say one thing when it reads another. Rules run from the top down, and what one rule writes is left alone by the rules under it. Nothing here changes a saved script." />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AliasMatchBox" Grid.Column="0" Padding="6,4" Margin="0,0,6,0"
                                     Tag="The word or symbol to look for"
                                     ToolTip="The word or symbol to look for" />
                            <TextBox x:Name="AliasSayAsBox" Grid.Column="1" Padding="6,4" Margin="0,0,6,0"
                                     Tag="What the voice should say instead"
                                     ToolTip="What the voice should say instead" />
                            <Button x:Name="AddAliasButton" Grid.Column="2" Content="Add" Width="90"
                                    Click="OnAddAlias" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="RemoveAliasButton" Content="Remove" Width="90" Click="OnRemoveAlias" />
                            <Button x:Name="MoveAliasUpButton" Content="Move up" Width="90" Click="OnMoveAliasUp" />
                            <Button x:Name="MoveAliasDownButton" Content="Move down" Width="90"
                                    Click="OnMoveAliasDown" />
                            <Button x:Name="ImportAliasesButton" Content="Import" Width="90"
                                    Click="OnImportAliases" Margin="12,0,0,0"
                                    ToolTip="Add the rules from a shared alias file" />
                            <Button x:Name="ExportAliasesButton" Content="Export" Width="90"
                                    Click="OnExportAliases" ToolTip="Write these rules to a file to share" />
                            <TextBlock x:Name="AliasCountText" VerticalAlignment="Center" Foreground="#777"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="AliasClashText" Foreground="#A05000" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,8" />

                        <TextBlock Text="Lists that come with the program" Foreground="#555"
                                   Margin="0,0,0,4" />
                        <WrapPanel x:Name="AliasPackPanel" Margin="0,0,0,4" />
                        <TextBlock x:Name="AliasPackText" Foreground="#777" Margin="0,0,0,8"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Your saved rulesets" Foreground="#555" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="SaveAliasRulesetButton" DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}" Content="&#xE792;"
                                    AutomationProperties.Name="Save ruleset" Click="OnSaveAliasRuleset"
                                    ToolTip="Save the rules shown above under this name" Margin="6,0,0,0" />
                            <Button x:Name="DeleteAliasRulesetButton" DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    AutomationProperties.Name="Delete ruleset" Click="OnDeleteAliasRuleset"
                                    ToolTip="Delete the saved ruleset of this name" Margin="6,0,0,0" />
                            <TextBox x:Name="AliasRulesetTitleBox" Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     Tag="A name to save these rules under"
                                     ToolTip="A name to save these rules under" />
                        </DockPanel>
                        <WrapPanel x:Name="AliasRulesetPanel" Margin="0,0,0,4" />
                        <TextBlock x:Name="AliasRulesetText" Foreground="#777" TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="UseAliasesBox" Content="Use these aliases when reading"
                                  Margin="0,0,0,8" Click="OnUseAliasesChanged" />

                        <TextBlock Text="Try it" Foreground="#555" Margin="0,0,0,4" />
                        <TextBox x:Name="AliasTryBox" Tag="Type a line here to see what the voice would be given" Padding="6,4" TextChanged="OnAliasTryChanged"
                                 ToolTip="Type a line here to see what the voice would be given" />
                        <Border Background="#F4F4F4" BorderBrush="#DDD" BorderThickness="1" Padding="6,4"
                                Margin="0,4,0,0">
                            <TextBlock x:Name="AliasResultText" TextWrapping="Wrap" MinHeight="18" />
                        </Border>
                    </StackPanel>

                    <TabControl x:Name="AliasGroupTabs" DockPanel.Dock="Top" Margin="0,0,0,-1"
                                Style="{StaticResource HeaderOnlyTabs}"
                                SelectionChanged="OnAliasGroupChanged" />

                    <DataGrid x:Name="AliasList" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="150"
                              CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="All" CellEditEnding="OnAliasRuleEdited"
                              LoadingRow="OnAliasRowLoaded">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Width="40"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="When it reads" Width="*"
                                                Binding="{Binding Match}" />
                            <DataGridTextColumn Header="Say" Width="*" Binding="{Binding SayAs}" />
                            <DataGridCheckBoxColumn Header="Whole word" Width="90"
                                                    Binding="{Binding WholeWord, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Match case" Width="90"
                                                    Binding="{Binding MatchCase, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="Reading" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reading speed"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="SettingsSpeedBox" Grid.Row="0" Grid.Column="1"
                                     ToolTip="How fast the voice reads. 1.0 is normal, 0.5 is half speed, 2.0 is double"
                                     Style="{StaticResource SettingBox}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Repeat"
                                       Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="SettingsRepeatBox" Grid.Row="1" Grid.Column="1" Width="160"
                                      ToolTip="Whether a finished reading starts again, either the one script or the whole queue"
                                      HorizontalAlignment="Left" Margin="0,0,0,8"
                                      SelectionChanged="OnSettingsRepeatChanged" />

                            <CheckBox x:Name="SettingsUseAliasesBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Use the alias list when reading" Margin="0,4,0,8"
                                      ToolTip="The Aliases tab replacements are applied before the voice sees the text"
                                      VerticalAlignment="Center" Checked="OnSettingsUseAliasesChanged"
                                      Unchecked="OnSettingsUseAliasesChanged" />

                            <CheckBox x:Name="SettingsReadAsYouTypeBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Read each word as I type it" Margin="0,4,0,8"
                                      ToolTip="The voice speaks each word as soon as you finish typing it"
                                      VerticalAlignment="Center" Checked="OnSettingsReadAsYouTypeChanged"
                                      Unchecked="OnSettingsReadAsYouTypeChanged" />

                            <CheckBox x:Name="SettingsPauseWhenUnfocusedBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Pause the reading when the window loses focus" Margin="0,4,0,8"
                                      ToolTip="Hold the reading whenever another window takes over"
                                      VerticalAlignment="Center" Checked="OnSettingsPauseWhenUnfocusedChanged"
                                      Unchecked="OnSettingsPauseWhenUnfocusedChanged" />
                        </Grid>

                        <TextBlock Text="Pauses" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Silence after line endings (ms)"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="SilenceLineEndingBox" Grid.Row="0" Grid.Column="1"
                                     ToolTip="Pause after a line ending, in milliseconds. 1000 is one second, 0 is no pause"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="0" Grid.Column="3" Tag="silence"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Silence after sentences (ms)"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="SilenceSentenceBox" Grid.Row="1" Grid.Column="1"
                                     ToolTip="Pause after a full stop, in milliseconds. Most voices already rest there on their own"
                                     Style="{StaticResource SettingBox}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Silence after questions (ms)"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="SilenceQuestionBox" Grid.Row="2" Grid.Column="1"
                                     ToolTip="Pause after a question mark, in milliseconds. The mark itself is never spoken"
                                     Style="{StaticResource SettingBox}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Silence after exclamations (ms)"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="SilenceExclamationBox" Grid.Row="3" Grid.Column="1"
                                     ToolTip="Pause after an exclamation mark, in milliseconds. The mark itself is never spoken"
                                     Style="{StaticResource SettingBox}" />

                            <CheckBox x:Name="ScaleSilenceBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Scale silence to the speech rate" Margin="0,4,0,8"
                                      ToolTip="Pauses shrink as the voice speeds up and stretch as it slows down"
                                      VerticalAlignment="Center" />
                            <Button Grid.Row="4" Grid.Column="3" Tag="scale-silence"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />
                        </Grid>

                        <TextBlock Text="What gets read" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Characters read aloud"
                                       Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="SpokenCharactersBox" Grid.Row="0" Grid.Column="1"
                                      ToolTip="Which characters survive to be spoken. Punctuation always becomes a pause"
                                      Margin="0,0,0,8" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,8" Foreground="#555"
                                       VerticalAlignment="Center"
                                       Text="Punctuation still becomes a pause" />
                            <Button Grid.Row="0" Grid.Column="3" Tag="spoken-characters"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Also read these characters"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="AllowedExtraBox" Tag="Characters to let through" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource SettingBox}"
                                     ToolTip="Type the characters themselves, with nothing between them. Press ? for examples." />
                            <Button Grid.Row="1" Grid.Column="3" Tag="allowed-extra"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <CheckBox x:Name="FilterHashBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Omit hash characters (#)" Margin="0,4,0,6"
                                      ToolTip="Takes out every hash, so a heading written as ## Chapter two reads as Chapter two" />
                            <Button Grid.Row="2" Grid.Column="3" Tag="filters"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <CheckBox x:Name="FilterWebBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Omit web links" Margin="0,0,0,6"
                                      ToolTip="Takes out any word starting http:// or https://, rather than spelling it out" />

                            <CheckBox x:Name="FilterMailBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Omit mailto links" Margin="0,0,0,8"
                                      ToolTip="Takes out any word starting mailto:, rather than spelling it out" />
                        </Grid>

                        <TextBlock Text="Audio files" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Default output directory"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="OutputDirBox" Tag="Where finished audio is written" Grid.Row="0" Grid.Column="1"
                                     ToolTip="The folder the Save dialog opens in. Empty means a TTS Util folder under Music"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse" Margin="8,0,0,8"
                                    Click="OnBrowseOutputDir" />
                            <Button Grid.Row="0" Grid.Column="3" Tag="output-directory"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Saved audio format"
                                       Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="OutputFormatBox" Grid.Row="1" Grid.Column="1"
                                      ToolTip="Which file type the Save dialog offers first. The extension you pick decides the format"
                                      Margin="0,0,0,8" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3" Tag="output-format"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MP3 bit rate (kbps)"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="Mp3BitRateBox" Grid.Row="2" Grid.Column="1"
                                     ToolTip="In kilobits per second, 32 to 320. One speaking voice needs little, so 128 is plenty"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="2" Grid.Column="3" Tag="mp3-bit-rate"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <CheckBox x:Name="SaveScriptWithAudioBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Save a script when writing audio" Margin="0,4,0,8"
                                      ToolTip="Writing audio from the Text tab also saves that text as a script of the same name"
                                      VerticalAlignment="Center" />
                            <Button Grid.Row="3" Grid.Column="3" Tag="save-script-with-audio"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="When a file finishes"
                                       Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="SettingsWriteNoticeBox" Grid.Row="4" Grid.Column="1" Width="240"
                                      ToolTip="How the program says a saved MP3 or WAV has finished, without you watching the status bar"
                                      HorizontalAlignment="Left" Margin="0,0,0,8"
                                      SelectionChanged="OnSettingsWriteNoticeChanged" />
                            <Button Grid.Row="4" Grid.Column="3" Tag="write-finished-notice"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />
                        </Grid>

                        <TextBlock Text="Voices" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Voices directory"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="VoicesDirBox" Tag="Where voice models are kept" Grid.Row="0" Grid.Column="1"
                                     ToolTip="Where voice models live, one folder each. Empty means the usual place. Press Rescan after changing it"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse" Margin="8,0,0,8"
                                    Click="OnBrowseVoicesDir" />
                            <Button Grid.Row="0" Grid.Column="3" Tag="voices-directory"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <CheckBox x:Name="UseWindowsVoicesBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Also offer the voices Windows already has" Margin="0,4,0,8"
                                      ToolTip="Lists the speech voices Windows ships with beside the downloaded ones"
                                      VerticalAlignment="Center" Click="OnUseWindowsVoicesChanged" />
                            <Button Grid.Row="1" Grid.Column="3" Tag="use-windows-voices"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />
                        </Grid>

                        <TextBlock Text="Performance" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Synthesis threads"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="ThreadsBox" Grid.Row="0" Grid.Column="1"
                                     ToolTip="How many threads a downloaded voice renders with, and nothing at all to the Windows voices. Empty works it out from the processor count. Most of the speed arrives by four threads"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="0" Grid.Column="3" Tag="threads"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum characters per chunk"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="ChunkLengthBox" Grid.Row="1" Grid.Column="1"
                                     ToolTip="How much text is handed to the voice at once, 64 to 20000. Smaller starts speaking sooner"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="1" Grid.Column="3" Tag="chunk-length"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />
                        </Grid>

                        <TextBlock Text="Window" Style="{StaticResource SettingGroup}" />
                        <Separator Style="{StaticResource SettingRule}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Editor text size"
                                       Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="SettingsFontSizeBox" Grid.Row="0" Grid.Column="1" Width="80"
                                      ToolTip="How big the text looks in the editor. Nothing that is saved changes"
                                      HorizontalAlignment="Left" Margin="0,0,0,8"
                                      SelectionChanged="OnSettingsFontSizeChanged" />

                            <CheckBox x:Name="WarnOnClosingUnsavedBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Ask before closing a tab with unsaved changes" Margin="0,4,0,8"
                                      ToolTip="A tab holding changes you have not saved asks first rather than closing straight away"
                                      VerticalAlignment="Center" />

                            <CheckBox x:Name="CloseToTrayBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Close to the notification area instead of quitting" Margin="0,4,0,8"
                                      VerticalAlignment="Center"
                                      ToolTip="The window hides among the hidden icons by the clock and keeps reading. Quit from that icon's menu" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Keep last messages"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="KeepLastMessagesBox" Grid.Row="3" Grid.Column="1"
                                     ToolTip="How many past status messages the history holds on to, and what Copy all writes out"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="3" Grid.Column="3" Tag="keep-last-messages"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Show last messages"
                                       Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="ShowLastMessagesBox" Grid.Row="4" Grid.Column="1"
                                     ToolTip="How many messages one page of the history shows. The rest are kept and are a page away"
                                     Style="{StaticResource SettingBox}" />
                            <Button Grid.Row="4" Grid.Column="3" Tag="show-last-messages"
                                    Style="{StaticResource HelpButton}" Click="OnSettingsHelp" />
                        </Grid>

                        <Popup x:Name="SettingsHelpPopup" Placement="Left" StaysOpen="False"
                               AllowsTransparency="True" HorizontalOffset="-6">
                            <Border Background="White" BorderBrush="#BBB" BorderThickness="1"
                                    Padding="12" MaxWidth="430">
                                <StackPanel>
                                    <TextBlock x:Name="SettingsHelpTitle" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock x:Name="SettingsHelpBody" TextWrapping="Wrap"
                                               Foreground="#333" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ApplySettingsButton" Content="Apply" Click="OnApplySettings" />
                            <Button x:Name="ResetSettingsButton" Content="Reset to defaults"
                                    Click="OnResetSettings" MinWidth="130"
                                    ToolTip="Put every setting back to how it started" />
                            <Button x:Name="ResetAliasesButton" Content="Reset aliases"
                                    Click="OnResetAliases" MinWidth="130"
                                    ToolTip="Empty the alias list, keeping a copy as aliases.json.bak" />
                            <TextBlock x:Name="SettingsPathText" VerticalAlignment="Center" Foreground="#555"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="UpdatesTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Updates" />
                        <TextBlock x:Name="UpdatesTabMark" Text="!" FontWeight="Bold" Foreground="#C0392B"
                                   Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="UpdateVersionText" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,2" />
                        <TextBlock x:Name="UpdateStateText" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <CheckBox x:Name="CheckForUpdatesBox" Margin="0,0,0,6"
                                  Content="Look for a new version when the program starts"
                                  Click="OnCheckForUpdatesChanged" />
                        <CheckBox x:Name="PromptForUpdatesBox" Margin="0,0,0,10"
                                  Content="Update prompt popup box on startup"
                                  Click="OnPromptForUpdatesChanged"
                                  ToolTip="Off by default: no update dialog opens anywhere, and a new version waits on this tab" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="CheckForUpdatesButton" Content="Check now" MinWidth="110"
                                    Click="OnCheckForUpdates"
                                    ToolTip="Look for a new version now, whatever the box says" />
                            <Button x:Name="InstallUpdateButton" Content="Install update" MinWidth="130"
                                    IsEnabled="False" Click="OnInstallUpdate"
                                    ToolTip="Download the new version found by the last check" />
                            <TextBlock x:Name="LastUpdateCheckText" VerticalAlignment="Center"
                                       Foreground="#777" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="The check asks a single published file whether a newer release exists. Nothing about you is sent: no identifier, no text, no list of voices, and no request at all while the box is clear." />
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,16"
                                   Text="An installed copy can offer to download the installer and run it, after checking the download against its published checksum. A portable copy is given the link instead, since replacing the folder it runs from is yours to do." />

                        <StackPanel x:Name="NewVersionPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock x:Name="NewVersionTitle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#1F6FEB" Margin="0,0,0,2" TextWrapping="Wrap" />
                            <TextBlock x:Name="NewVersionEmptyText" Foreground="#777" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Text="The release page has the details of what changed." />
                            <ItemsControl x:Name="NewVersionNotes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#444"
                                                   Margin="10,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="What changed" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,2" />
                        <TextBlock Foreground="#777" Margin="0,0,0,8"
                                   Text="Newest first, as it stood when this build was made." />
                        <ItemsControl x:Name="ChangelogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Notes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="#444" Margin="10,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="TTS Util Win" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock x:Name="VersionText" Foreground="#555" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="A Windows port of TTS Util that synthesizes speech locally with sherpa-onnx. No network access and no system speech engine are required." />
                        <TextBlock x:Name="AboutVoicesText" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="TTS Util Win is a Windows port of TTS Util by Dane Finlay, and is not endorsed by that project. It is licensed under the Apache License 2.0, as are TTS Util and the sherpa-onnx library by the k2-fsa project. The NOTICE and THIRD-PARTY-NOTICES.txt files beside the program name every component it ships. Each voice model carries its own license; see the LICENSE file inside the model folder." />
                        <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#444" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
